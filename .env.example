# Copia este archivo a ".env" y completa con tus valores reales.
# NUNCA subas el archivo ".env" real a GitHub.

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=tu-password-de-neon
DB_HOST=tu-host-pooler.neon.tech
DB_PORT=5432

# Umbral de confianza del reconocimiento facial (LBPH). Entre más bajo,
# más estricto es el sistema para aceptar una coincidencia.
LBPH_CONFIDENCE_THRESHOLD=70
